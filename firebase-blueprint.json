{
  "entities": {
    "assignment": {
      "title": "Assignment",
      "description": "An online worksheet or assignment created by a teacher",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the assignment",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Assignment title",
          "maxLength": 300
        },
        "subject": {
          "type": "string",
          "description": "School subject",
          "maxLength": 100
        },
        "gradeLevel": {
          "type": "string",
          "description": "Grade level e.g. ม.3",
          "maxLength": 50
        },
        "category": {
          "type": "string",
          "description": "Worksheet category",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Description of the assignment",
          "maxLength": 2000
        },
        "instructions": {
          "type": "string",
          "description": "Instructions for students",
          "maxLength": 2000
        },
        "questions": {
          "type": "array",
          "description": "List of questions in the worksheet"
        },
        "totalPoints": {
          "type": "number",
          "description": "Total max points"
        },
        "dueDate": {
          "type": "string",
          "description": "Due date ISO string",
          "maxLength": 100
        },
        "createdDate": {
          "type": "string",
          "description": "Creation date ISO string",
          "maxLength": 100
        },
        "teacherName": {
          "type": "string",
          "description": "Name of the teacher",
          "maxLength": 200
        }
      },
      "required": ["id", "title", "subject", "gradeLevel", "totalPoints", "dueDate"]
    },
    "submission": {
      "title": "Submission",
      "description": "A student's submitted response to an assignment",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the submission",
          "maxLength": 128
        },
        "assignmentId": {
          "type": "string",
          "description": "ID of the associated assignment",
          "maxLength": 128
        },
        "studentId": {
          "type": "string",
          "description": "Student profile ID",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "Student full name",
          "maxLength": 200
        },
        "studentCode": {
          "type": "string",
          "description": "Student ID code",
          "maxLength": 64
        },
        "gradeLevel": {
          "type": "string",
          "description": "Student grade level",
          "maxLength": 50
        },
        "submissionDate": {
          "type": "string",
          "description": "Date and time of submission",
          "maxLength": 100
        },
        "answers": {
          "type": "object",
          "description": "Map of question ID to student answer"
        },
        "status": {
          "type": "string",
          "description": "Status of submission",
          "maxLength": 50
        },
        "score": {
          "type": "number",
          "description": "Score given by teacher or AI"
        },
        "maxScore": {
          "type": "number",
          "description": "Maximum possible score"
        },
        "teacherComment": {
          "type": "string",
          "description": "Feedback or comment from the teacher",
          "maxLength": 3000
        },
        "gradedAt": {
          "type": "string",
          "description": "Timestamp when graded",
          "maxLength": 100
        }
      },
      "required": ["id", "assignmentId", "studentCode", "status"]
    },
    "student": {
      "title": "Student",
      "description": "Student user record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique student identifier",
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "description": "Student ID number used for login",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Student full name",
          "maxLength": 200
        },
        "password": {
          "type": "string",
          "description": "Student password",
          "maxLength": 128
        },
        "gradeLevel": {
          "type": "string",
          "description": "Current grade level",
          "maxLength": 50
        },
        "avatar": {
          "type": "string",
          "description": "Avatar image URL",
          "maxLength": 1000
        }
      },
      "required": ["id", "code", "name", "password", "gradeLevel"]
    },
    "categorySetting": {
      "title": "CategorySetting",
      "description": "Custom grade levels and subjects settings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Setting ID",
          "maxLength": 128
        },
        "gradeLevels": {
          "type": "array",
          "description": "Array of grade levels"
        },
        "subjects": {
          "type": "array",
          "description": "Array of school subjects"
        },
        "periodConfigs": {
          "type": "array",
          "description": "Array of configured class periods including lunch break"
        },
        "studentGradebookEnabled": {
          "type": "boolean",
          "description": "Whether students can access their gradebook view"
        },
        "gradebookDisabledRooms": {
          "type": "array",
          "description": "List of specific classroom names where student gradebook access is disabled"
        }
      },
      "required": ["id"]
    },
    "learningResource": {
      "title": "LearningResource",
      "description": "Educational media resource such as video, slide, document, or web link categorized by subject and room",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique resource ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Resource title",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Resource description",
          "maxLength": 2000
        },
        "subject": {
          "type": "string",
          "description": "Subject name",
          "maxLength": 100
        },
        "gradeLevel": {
          "type": "string",
          "description": "Target room or grade level (e.g. ม.1/1, ม.1, ทั้งหมด)",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "description": "Type of resource: video, document, link, slide",
          "enum": ["video", "document", "link", "slide"],
          "maxLength": 50
        },
        "url": {
          "type": "string",
          "description": "Resource URL or video link",
          "maxLength": 2000
        },
        "createdDate": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 100
        },
        "teacherName": {
          "type": "string",
          "description": "Teacher who published the resource",
          "maxLength": 200
        }
      },
      "required": ["id", "title", "subject", "gradeLevel", "type", "url"]
    },
    "teachingSchedule": {
      "title": "TeachingSchedule",
      "description": "A teacher's scheduled class period for a specific day, period, subject, and room",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique schedule ID",
          "maxLength": 128
        },
        "teacherId": {
          "type": "string",
          "description": "Teacher profile ID",
          "maxLength": 128
        },
        "teacherCode": {
          "type": "string",
          "description": "Teacher code",
          "maxLength": 64
        },
        "teacherName": {
          "type": "string",
          "description": "Teacher full name",
          "maxLength": 200
        },
        "dayOfWeek": {
          "type": "string",
          "description": "Day of week",
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday"],
          "maxLength": 20
        },
        "period": {
          "type": "number",
          "description": "Period number (0-12, where 0 represents break/lunch period)"
        },
        "endPeriod": {
          "type": "number",
          "description": "Optional ending period number for consecutive multi-period classes (0-12)"
        },
        "startTime": {
          "type": "string",
          "description": "Start time HH:mm",
          "maxLength": 20
        },
        "endTime": {
          "type": "string",
          "description": "End time HH:mm",
          "maxLength": 20
        },
        "subject": {
          "type": "string",
          "description": "Subject name",
          "maxLength": 100
        },
        "gradeLevel": {
          "type": "string",
          "description": "Target room or grade level (e.g. ม.3/1)",
          "maxLength": 50
        },
        "classroom": {
          "type": "string",
          "description": "Physical classroom or lab name",
          "maxLength": 100
        },
        "note": {
          "type": "string",
          "description": "Optional note",
          "maxLength": 500
        }
      },
      "required": ["id", "teacherId", "teacherCode", "teacherName", "dayOfWeek", "period", "startTime", "endTime", "subject", "gradeLevel"]
    },
    "attendanceSession": {
      "title": "AttendanceSession",
      "description": "Classroom attendance check-in record for a specific date and teaching period",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique attendance session ID",
          "maxLength": 128
        },
        "scheduleId": {
          "type": "string",
          "description": "Reference teaching schedule ID",
          "maxLength": 128
        },
        "date": {
          "type": "string",
          "description": "Session date YYYY-MM-DD",
          "maxLength": 20
        },
        "dayOfWeek": {
          "type": "string",
          "description": "Day of week",
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday"],
          "maxLength": 20
        },
        "period": {
          "type": "number",
          "description": "Period number"
        },
        "endPeriod": {
          "type": "number",
          "description": "Optional ending period number when checking attendance for consecutive periods (0-12)"
        },
        "startTime": {
          "type": "string",
          "description": "Start time",
          "maxLength": 20
        },
        "endTime": {
          "type": "string",
          "description": "End time",
          "maxLength": 20
        },
        "subject": {
          "type": "string",
          "description": "Subject name",
          "maxLength": 100
        },
        "gradeLevel": {
          "type": "string",
          "description": "Grade level and room",
          "maxLength": 50
        },
        "teacherId": {
          "type": "string",
          "description": "Teacher profile ID",
          "maxLength": 128
        },
        "teacherCode": {
          "type": "string",
          "description": "Teacher code",
          "maxLength": 64
        },
        "teacherName": {
          "type": "string",
          "description": "Teacher full name",
          "maxLength": 200
        },
        "topicTaught": {
          "type": "string",
          "description": "Lesson topic taught in this period",
          "maxLength": 500
        },
        "records": {
          "type": "array",
          "description": "List of student attendance records"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp",
          "maxLength": 100
        }
      },
      "required": ["id", "date", "dayOfWeek", "period", "subject", "gradeLevel", "teacherId", "teacherCode", "teacherName", "records", "updatedAt"]
    }
  },
  "firestore": {
    "/assignments/{assignmentId}": {
      "schema": {
        "$ref": "#/entities/assignment"
      },
      "description": "Worksheets and assignments created by teachers"
    },
    "/submissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/submission"
      },
      "description": "Student submissions and grading feedback"
    },
    "/students/{studentId}": {
      "schema": {
        "$ref": "#/entities/student"
      },
      "description": "Student roster and login credentials"
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/categorySetting"
      },
      "description": "Global school grade levels and subjects configurations"
    },
    "/resources/{resourceId}": {
      "schema": {
        "$ref": "#/entities/learningResource"
      },
      "description": "Learning media library for students and teachers"
    },
    "/teachingSchedules/{scheduleId}": {
      "schema": {
        "$ref": "#/entities/teachingSchedule"
      },
      "description": "Teacher weekly teaching schedules per subject and classroom"
    },
    "/attendanceSessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/attendanceSession"
      },
      "description": "Daily classroom attendance check-in records linked to teaching schedules"
    }
  }
}
