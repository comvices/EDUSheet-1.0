rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection doc used at startup
    match /test/{testId} {
      allow read, write: if true;
    }

    // Assignments collection
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(assignmentId);
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update, delete: if isValidId(submissionId);
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if isValidId(studentId);
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update, delete: if isValidId(teacherId);
    }

    // Settings collection (Grade levels and subjects)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }
  }
}
